# ==========================================
# AAGROO SERVER CONFIGURATION
# ==========================================

PORT=8000
HOST=0.0.0.0
DEBUG=True


# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# If MySQL connection fails or credentials are wrong, Aagroo automatically 
# falls back to SQLite (agriculture.db) so your app always works out-of-the-box!

# MySQL Settings:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Muthu@0145
DB_NAME=agriculture_db

# Custom Connection URL (Optional - for SQLite, PostgreSQL, Supabase, etc.):
# DATABASE_URL=sqlite:///./agriculture.db
# DATABASE_URL=mysql+mysqlconnector://root:your_password@localhost:3306/agriculture_db


# ==========================================
# SECURITY & CORS CONFIGURATION
# ==========================================

SECRET_KEY=aagroo_super_secret_jwt_key_2026

ALLOWED_ORIGINS=*


# ==========================================
# OPTIONAL INTEGRATIONS
# ==========================================

WEATHER_API_KEY=your_openweathermap_api_key

OPENAI_API_KEY=your_openai_api_key